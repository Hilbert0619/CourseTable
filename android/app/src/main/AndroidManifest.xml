<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The Words tab: sign-in and sync with the Supabase project. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Class, to-do and focus notifications (asked for at run time on Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16 Live Updates: the class and focus notifications in the status bar (granted at install). -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- One exact alarm for the next class or to-do event and one for the next focus switch. USE_EXACT_ALARM is
         granted at install on Android 13+; on 12 the other one is. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <!-- Sets the alarms again after a restart. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Settings → Reliable Reminders asks to turn battery optimisation off. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- The focus sound keeps playing in the background with the screen off. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Pronunciation: the phone's text-to-speech engine (package visibility, Android 11+). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".StudyHourApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.StudyHour">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Sign-up confirmation and password-reset links from Supabase's email (the iOS URL scheme). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="auth-callback"
                    android:scheme="io.github.hilbert0619.coursetable" />
            </intent-filter>
        </activity>

        <!-- Home-screen widget: current or next class, and today's classes. -->
        <receiver
            android:name=".widget.ScheduleWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/schedule_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.ScheduleWidgetUpdates$RefreshReceiver"
            android:exported="false" />

        <!-- The alarms and the notification buttons (classes, to-dos, focus). -->
        <receiver
            android:name=".alerts.AlertReceiver"
            android:exported="false" />

        <!-- Restart, a new app version, the clock or time zone changed, exact alarms allowed: set the alarms again. -->
        <receiver
            android:name=".alerts.SystemEventReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Runs only while a focus session plays a sound, so it keeps playing in the background. -->
        <service
            android:name=".focus.FocusSoundService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!--
            StudyHour's own island around the camera hole (island/Island.kt), turned on by the person in the
            accessibility settings. Only the system can bind it (the permission); it reads no screen content.
        -->
        <service
            android:name=".island.IslandService"
            android:exported="true"
            android:label="@string/island_title"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/island_service" />
        </service>

        <!-- Shares the exported CSV with other apps. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
