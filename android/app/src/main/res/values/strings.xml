    <!-- Reliable reminders -->
    <string name="reliable_intro">Android saves power by stopping apps in the background, and phones from vivo, iQOO and other brands do it more strictly. Then class reminders, to-do notifications and focus alerts can come late or not at all. Allow the items below.</string>
    <string name="permissions">Permissions</string>
