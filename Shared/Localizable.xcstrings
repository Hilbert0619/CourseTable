    "Your own meaning" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用你的释义"
          }
        }
      }
    },
    "Your questions go straight from this iPhone to the provider you chose, under their terms, and are paid from your account with them. CourseTable's server never sees them. Keys stay in this iPhone's Keychain." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的提问直接从这台 iPhone 发送到你选择的服务商，适用其条款，费用从你在该服务商的账户中扣除。课程表的服务器不会看到这些内容。密钥只保存在这台 iPhone 的钥匙串中。"
          }
        }
      }
    },
