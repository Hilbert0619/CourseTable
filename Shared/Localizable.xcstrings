          }
        }
      }
    },
    "Your account with this provider has no credit or quota left." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你在该服务商的账户已没有余额或额度。"
          }
        }
      }
    },
    "Your computer's address on this Wi-Fi with the server's port and /v1, e.g. http://192.168.1.2:11434/v1 for Ollama or :1234/v1 for LM Studio." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "电脑在此 Wi-Fi 中的地址，加上服务端口和 /v1，例如 Ollama 用 http://192.168.1.2:11434/v1，LM Studio 用 :1234/v1。"
          }
        }
      }
    },
    "Your course list" : {
