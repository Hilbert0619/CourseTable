# This repo is edited on Windows and macOS: store and check out text as LF everywhere.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.heic binary
*.m4a binary
*.wav binary

# Shared test files in exact encodings (GB18030, UTF-16): keep their bytes
spec/fixtures/*.csv binary
